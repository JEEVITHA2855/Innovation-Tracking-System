PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/innovation_tracking?schema=public"
JWT_SECRET=replace_with_long_random_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_long_random_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend-domain.vercel.app
CLIENT_URL=http://localhost:5173
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
